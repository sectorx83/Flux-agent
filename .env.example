# Required for AI requests. Never commit real keys.
GROQ_API_KEY=

# Optional fallback provider keys
GEMINI_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# Optional overrides
FLUX_MODEL=openai/gpt-oss-120b
FLUX_WORKSPACE=.
FLUX_CONFIG=
FLUX_FALLBACK_PROVIDERS=
FLUX_REMOTE_URL=
FLUX_REMOTE_TOKEN=

# Optional official service API credentials. Flux reads these at runtime.
# Google access tokens must be issued with the required Google Tasks scope.
GITHUB_TOKEN=
SLACK_BOT_TOKEN=
DISCORD_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=
GOOGLE_ACCESS_TOKEN=
NOTION_TOKEN=

# Optional remote device database path
FLUX_REMOTE_DEVICE_DB=
